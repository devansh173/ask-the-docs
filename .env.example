# ---------------------------------------------------------------------------
# Copy to .env and fill in what you need. Everything here has a working default
# except the LLM key - the app starts without one, but cannot generate an answer
# until either this is set or a key is supplied from the UI.
# ---------------------------------------------------------------------------

# --- LLM provider ----------------------------------------------------------
# The frontend can override all of this per request. These are the fallbacks.
#
# Provider ids are the LangChain package names, but the obvious vendor names
# work too: gemini/google -> google_genai, claude -> anthropic, gpt -> openai.
#   anthropic   claude-opus-5 | claude-sonnet-5 | claude-haiku-4-5
#   gemini      gemini-3-pro | gemini-3-flash | gemini-2.5-pro
#               gemini-2.5-flash | gemini-2.5-flash-lite
#   openai      gpt-5.2 | gpt-5.2-mini | gpt-5.1
#   ollama      llama3.2 | qwen3 | mistral | phi4   (no key needed)
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-5
# Grading and groundedness fire on every query AND on every golden question in
# an eval run, so this is the single biggest lever on what evaluation costs.
# Point it at the cheapest model that still grades reliably. If your generator
# is already the cheapest in its family (e.g. gemini-2.5-flash-lite), just use
# the same model here.
GRADER_MODEL=claude-sonnet-5

ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# OPENAI_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434

# --- Retrieval models ------------------------------------------------------
# Each embedding model gets its own Qdrant collection, because vector
# dimensionality is fixed when a collection is created. Switching this means
# re-indexing. Options: bge-small, minilm, bge-base, nomic, mxbai,
# e5-multilingual, qwen3 (qwen3 needs requirements-quality.txt).
EMBEDDING_MODEL=bge-small
# none, minilm-l6, bge-base, jina-v2, bge-v2-m3 (bge-v2-m3 needs torch)
# Defaults to none: the ablation in evals_out/ found the cross-encoder lowered
# MRR on this corpus while costing ~59x the retrieval latency on CPU. Turn it on
# for corpora with more distractors, or on better hardware.
RERANKER_MODEL=none

# --- Storage ---------------------------------------------------------------
# Leave QDRANT_URL unset to use embedded local mode - no Docker, no signup.
# Set it to run against a server:
#   docker compose up -d     -> http://localhost:6333
#   Qdrant Cloud free tier   -> https://xyz.cloud.qdrant.io:6333
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
QDRANT_COLLECTION=askthedocs

# Where embedded Qdrant keeps its SQLite store. Defaults to a cache directory
# OUTSIDE the repo (%LOCALAPPDATA% / ~/.cache). That is deliberate: embedded
# Qdrant commits once per point, and if the store sits in a synced folder
# (OneDrive, Dropbox, iCloud) the sync client re-uploads the whole growing file
# after every commit and indexing slows to a crawl.
# QDRANT_LOCAL_PATH=

# --- Chunking and corpus size ----------------------------------------------
# Embedding cost is dominated by sequence length - attention is O(n^2) - so
# chunk_size affects indexing time far more than any threading setting.
CHUNK_SIZE=600
CHUNK_OVERLAP=100
# Pages taken per doc set at index time, highest-priority first. Pages the
# golden set labels are always included regardless. 0 = no limit (~12k chunks,
# and roughly 90 minutes to index on a laptop CPU).
INDEX_MAX_PAGES_PER_SET=25

# --- Pipeline tuning -------------------------------------------------------
DENSE_PREFETCH=40      # candidates from the dense arm
SPARSE_PREFETCH=40     # candidates from the BM25 arm
FUSION_LIMIT=20        # survivors of RRF, handed to the cross-encoder
TOP_K=5                # survivors of reranking, handed to the generator
MAX_RETRIES=2          # query rewrites before abstaining
RELEVANCE_THRESHOLD=0.5

USE_HYBRID=true
USE_RERANKER=false
USE_SELF_CORRECTION=true

# --- Observability ---------------------------------------------------------
# Cloud free tier by default. Self-hosting needs 16 GiB RAM - see
# docker-compose.langfuse.yml for why this is not the default.
LANGFUSE_ENABLED=true
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

LOG_LEVEL=INFO
